# cp .env.example .env && chmod 600 .env   (gitignored)

# Optional. Leave blank for interactive login (approve the URL from `docker logs mam-ts`).
# If used: tagged tag:mam-stack, pre-approved, NOT reusable.
TS_AUTHKEY=

# A Mullvad exit node as listed by `tailscale exit-node list` on xps.
MULLVAD_EXIT_NODE=

MOUSEHOLE_AUTH_PASSWORD=

# Library disk root. For the MK-153 proof leave unset (./data/library);
# after the MK-154 cutover: /mnt/library
# LIBRARY_DIR=/mnt/library

# Tailnet ACL prerequisites (admin console):
#  - tagOwners: "tag:mam-stack": ["autogroup:admin"]
#  - grant your user/devices -> tag:mam-stack (webUIs :8080 :9696 :8084 :5010)
#  - tag:mam-stack must NOT be granted access to other tailnet hosts
#    (it's the internet-facing-ish tier, like the old seedbox tag)
#  - the Mullvad nodeAttr/grant for tag:mam-stack to use exit nodes

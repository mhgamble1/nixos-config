# secrets.nix — gitignored, create as /etc/nixos/secrets.nix
# Copy this to /etc/nixos/secrets.nix and fill in your values
{
  # SSH authorized keys for the mhg user
  authorizedKeys.mark = [
    # "ssh-ed25519 AAAA... your-key-comment"
  ];

  # NAS configuration (only needed for desktop)
  nas = {
    ip = "192.168.x.x";
  };

  # Desktop's Tailscale hostname (used by laptop's distributed build config)
  desktop = {
    hostname = "desktop.your-tailnet.ts.net";
  };

  # T14's Tailscale hostname (used by xps-server's distributed build config,
  # once t14 is provisioned and distributedBuilds is flipped on)
  t14 = {
    hostname = "t14.your-tailnet.ts.net";
  };

  # DB password for xps-server's self-hosted AFFiNE (services/xps-server/affine/).
  affine = {
    dbPassword = "";
  };
}
